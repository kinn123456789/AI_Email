<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed Campaigns</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen p-10 font-sans text-stone-800"
      style="background-image: url('/static/background.png');
             background-size: cover;
             background-position: center;
             background-repeat: no-repeat;">

    <div class="flex justify-between items-center mb-8">

        <h1 class="text-3xl font-bold">
            Completed Campaigns
        </h1>

        <a
            href="/trial-followup"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg"
        >
            ← Trial Dashboard
        </a>

    </div>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">

        {% if rows %}

        <table class="w-full">

            <thead class="bg-gray-100">

                <tr>
                    <th class="p-4 text-left">Learner ID</th>
                    <th class="p-4 text-left">Parent ID</th>
                    <th class="p-4 text-left">Trial Expired</th>
                    <th class="p-4 text-left">Email 1</th>
                    <th class="p-4 text-left">Email 2</th>
                    <th class="p-4 text-left">Email 3</th>
                    <th class="p-4 text-left">Status</th>
                </tr>

            </thead>

            <tbody>

            {% for row in rows %}

                <tr class="border-t">

                    <td class="p-4 font-mono text-xs">
                        {{ row.learner_id }}
                    </td>

                    <td class="p-4 font-mono text-xs">
                        {{ row.parent_id }}
                    </td>

                    <td class="p-4">
                        {{ row.trial_expiry_at.strftime("%d %b %Y") }}
                    </td>

                    <td class="p-4">
                        {{ row.email1_sent_at.strftime("%d %b %Y") }}
                    </td>

                    <td class="p-4">
                        {{ row.email2_sent_at.strftime("%d %b %Y") }}
                    </td>

                    <td class="p-4">
                        {{ row.email3_sent_at.strftime("%d %b %Y") }}
                    </td>

                    <td class="p-4">
                        <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full">
                            Completed
                        </span>
                    </td>

                </tr>

            {% endfor %}

            </tbody>

        </table>

        {% else %}

        <div class="p-10 text-center text-gray-500">
            No completed campaigns found.
        </div>

        {% endif %}

    </div>

</body>
</html>